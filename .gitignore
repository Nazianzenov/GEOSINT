# python
.venv/
__pycache__/
*.pyc

# node — dev/CI lint tooling only (eslint); the workbench needs no Node at runtime
node_modules/

# PyInstaller build output (built per-OS on demand; never committed)
build/
dist/
*.manifest

# generated build artifacts (rebuilt by run.ps1)
wiki/site/
app/data/search-index.json
app/data/graph.json
app/data/submarine-cables.json

# user-saved source pages (large, user-provided)
import/

# runtime caches that regenerate themselves
cache/

# local-only: gallery scraping/parsing stays off the repo
tools/import_geohints.py

# local-only planning docs
ROADMAP.md
docs/scoping/

# local-only training/CTF exercises (link-only; not for redistribution)
challenges/

# agentic code review — local tooling & output, not for prod
# (the agents in .claude/ stay TRACKED so the team shares the workflow)
/launch-review-sprint.sh
/install-sprint-kit.sh
/launch-review-sprint.ps1
/install-sprint-kit.ps1
/sprints/
# per-instance worktrees created during a sprint
/sprint-impl-*/
