# Treat cached image assets as binary — never normalize line endings.
# (SVGs are XML/text but are vendored verbatim; keep them byte-stable.)
wiki/docs/assets/** binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.svg -text

# Cached upstream data — keep LF, don't normalize.
data/*.json -text
data/*.txt -text

# Shell scripts + container/CI files MUST stay LF — CRLF breaks the shebang on
# macOS/Linux (bad interpreter) and inside Docker.
*.sh text eol=lf
run.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
